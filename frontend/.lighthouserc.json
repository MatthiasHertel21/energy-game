{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "numberOfRuns": 2,
      "url": [
        "/",
        "/login",
        "/kse",
        "/trainer",
        "/catalog"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.8 }],
        "categories:performance": ["warn", { "minScore": 0.6 }]
      }
    },
    "upload": {
      "target": "filesystem"
    }
  }
}
