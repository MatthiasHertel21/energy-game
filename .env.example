# Backend
FLASK_ENV=production
JWT_SECRET_KEY=change-this-in-prod
DATABASE_URL=postgresql+psycopg2://emsg:emsgpass@postgres:5432/emsg
APP_LOG_LEVEL=INFO

# Postgres
POSTGRES_DB=emsg
POSTGRES_USER=emsg
POSTGRES_PASSWORD=emsgpass

# Frontend
VITE_API_BASE=

# Traefik / Domain (optional)
TRAEFIK_DOMAIN=iq.2b6.de

# SMTP (Google SMTP Relay)
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=

# CORS (comma-separated origins or * for all)
CORS_ALLOW_ORIGINS=*

# Redis (used by SocketIO and Rate Limiter)
REDIS_URL=redis://redis:6379/0
SMTP_FROM=noreply@fastbreak.one

# KSE Chat – LLM-Assistent für Designer (optional)
# Provider: groq | gemini | openai
KSECHAT_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Groq-Modelle: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# Gemini-Modelle: gemini-1.5-flash, gemini-1.5-pro
# OpenAI-Modelle: gpt-4o-mini, gpt-4o
KSECHAT_MODEL=llama-3.3-70b-versatile